{
  "name": "pooltrace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "26.3.1",
    "bun": "1.3.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:toolchain && bun run typecheck && bun run lint && bun run format:check",
    "check:toolchain": "node scripts/check-toolchain.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/@biomejs/biome/bin/biome lint .",
    "format:check": "node node_modules/@biomejs/biome/bin/biome format .",
    "format": "node node_modules/@biomejs/biome/bin/biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
