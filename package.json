{
  "name": "pooltrace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "26.3.1",
    "bun": "1.3.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:toolchain && bun run typecheck && bun run lint && bun run format:check && bun run test",
    "check:toolchain": "node scripts/check-toolchain.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p packages/domain && node node_modules/typescript/bin/tsc -p packages/protocols && node node_modules/typescript/bin/tsc -p apps/backend && node apps/web/typecheck.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "check:live": "node scripts/check-live.ts",
    "check:quotes:live": "node scripts/check-quotes-live.ts",
    "cli": "node apps/backend/src/cli.ts",
    "research:arb-01": "node apps/backend/src/research.ts",
    "dev": "node scripts/local/start.ts",
    "dev:backend": "node apps/backend/src/server.ts",
    "dev:web": "node apps/web/dev.ts",
    "build:web": "node apps/web/build.ts",
    "lint": "node node_modules/@biomejs/biome/bin/biome lint .",
    "format:check": "node node_modules/@biomejs/biome/bin/biome format .",
    "format": "node node_modules/@biomejs/biome/bin/biome format --write .",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "check:workflow": "node scripts/ci/check-workflow.ts",
    "ci:metadata": "node scripts/ci/metadata.ts",
    "browser:install": "node node_modules/@playwright/test/cli.js install --with-deps chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "@playwright/test": "1.65.1",
    "yaml": "2.9.1"
  }
}
