{
  "name": "pooltrace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": "26.3.1",
    "bun": "1.3.11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "bun run check:toolchain && bun run typecheck && bun run lint && bun run format:check && bun run test",
    "check:toolchain": "node scripts/check-toolchain.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/typescript/bin/tsc -p packages/domain && node node_modules/typescript/bin/tsc -p packages/protocols && node node_modules/typescript/bin/tsc -p apps/backend",
    "test": "node node_modules/vitest/vitest.mjs run",
    "check:live": "node scripts/check-live.ts",
    "check:quotes:live": "node scripts/check-quotes-live.ts",
    "cli": "node apps/backend/src/cli.ts",
    "lint": "node node_modules/@biomejs/biome/bin/biome lint .",
    "format:check": "node node_modules/@biomejs/biome/bin/biome format .",
    "format": "node node_modules/@biomejs/biome/bin/biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
