# Configuration template for future approved backend work.
# M1-01 checks do not use RPC configuration or make RPC requests.
# Copy to .env only when configuring a later runnable backend task.
# Keep real credentials in ignored .env files; never use a NEXT_PUBLIC_ prefix for RPC credentials.

# Ethereum mainnet read-only RPC URL. Supply your own provider URL in .env.
# Reserved for the registry/snapshot task; no provider or endpoint is selected here.
ETHEREUM_RPC_URL=
