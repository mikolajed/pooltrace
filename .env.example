# Configuration for the explicit live CLI and read-only integration checks.
# Copy to .env at the repository root. Offline checks and CLI fixture mode need no RPC credentials.
# Keep real credentials in ignored .env files; never use a NEXT_PUBLIC_ prefix for RPC credentials.

# Ethereum mainnet read-only RPC URL. Supply your own provider URL in .env.
ETHEREUM_RPC_URL=

# Nonsecret provenance labels, never URLs, keys, or account identifiers.
# Change the configuration revision when changing the selected endpoint.
RPC_PROVIDER_LABEL=alchemy-ethereum
RPC_CONFIG_REVISION=alchemy-ethereum-v1

# Optional quotation grid: six increasing, distinct USDC decimal strings, never floating-point numbers.
# CLI precedence: --sizes JSON, then this setting, then the defaults below (both modes).
USDC_INPUT_AMOUNTS='["10","50","100","500","1000","5000"]'

# Optional backend-only local SQLite path. Omit to keep separate live/fixture defaults:
# data/pooltrace.sqlite and data/pooltrace-fixture.sqlite, relative to the repository root.
# An explicitly shared path retains both origins. Empty, URI, and :memory: paths are rejected.
# POOLTRACE_DB_PATH=data/pooltrace.sqlite
